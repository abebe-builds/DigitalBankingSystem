{
  "name": "digital-banking",
  "version": "0.1.0",
  "description": "Digital Banking System - Phase 1 backend foundation (Express + MySQL/MariaDB)",
  "type": "module",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/db/init.js",
    "migrate": "node src/db/migrate.js",
    "migrate:status": "node src/db/migrate.js --status",
    "test": "node --test --test-force-exit tests/*.test.js",
    "check": "node scripts/check-syntax.js",
    "seed:dev": "node scripts/seed-dev-users.js",
    "backup": "node scripts/backup-db.js",
    "restore": "node scripts/restore-db.js",
    "deploy-check": "node scripts/deploy-check.js"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "express-mysql-session": "3.0.0",
    "express-rate-limit": "7.4.1",
    "express-session": "1.18.1",
    "helmet": "8.0.0",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "mysql2": "3.11.0",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "supertest": "7.1.0"
  }
}
