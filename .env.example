# DigitalBank ETB — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development          # Set to 'production' for deployment
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=                  # Production: use a dedicated DB user (not root)
DB_NAME=digital_banking

# ── Session ──────────────────────────────────────────────────────────────────
# PRODUCTION: generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-me-in-production
SESSION_MAX_AGE_MS=28800000   # 8 hours in milliseconds
COOKIE_SECURE=false           # Set to true in production (requires HTTPS)

# ── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12              # Cost factor for password hashing (10–14 recommended)
LOGIN_MAX_ATTEMPTS=5          # Failed attempts before account lockout
LOGIN_LOCK_MINUTES=15         # Lockout duration in minutes

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# PRODUCTION: set RATE_LIMIT_MAX_API=100 and RATE_LIMIT_MAX_LOGIN=5
RATE_LIMIT_MAX_API=500        # Max requests per 15 min on /api (high for dev/test)
RATE_LIMIT_MAX_LOGIN=50       # Max login attempts per 15 min per IP

# ── OTP ──────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10         # OTP validity window
OTP_MAX_ATTEMPTS=3            # Failed OTP attempts before lockout

# ── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads            # Local directory for uploaded files (relative to project root)
MAX_FILE_SIZE_MB=5            # Maximum upload size in MB

# ── CORS ─────────────────────────────────────────────────────────────────────
# PRODUCTION: set to your frontend domain, e.g. https://banking.example.com
# Leave unset for development (allows localhost)
# CORS_ORIGIN=https://banking.example.com

# ── Transaction Limits (fallback if DB limits not found) ─────────────────────
MAX_DAILY_WITHDRAWAL_ETB=50000
MAX_SINGLE_TRANSACTION_ETB=20000

# ── Backup Scripts ────────────────────────────────────────────────────────────
# Optional: override mysqldump/mysql paths if not in PATH
# MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
# MYSQL_PATH=C:\xampp\mysql\bin\mysql.exe
